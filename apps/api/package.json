{
  "name": "@reviewlens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint src",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@reviewlens/core": "*",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "picomatch": "4.0.7",
    "pino": "^10.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/picomatch": "4.0.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}

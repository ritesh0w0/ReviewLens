# ReviewLens Environment Variables (Local Development & Testing)
PORT=3001
NODE_ENV=development

# Webhook Secret (Development dummy secret; replace with real secret in production)
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# PostgreSQL Development Database (reviewlens-db Docker container mapped to host 127.0.0.1:55432)
DATABASE_URL="postgresql://reviewlens:reviewlens_dev_password@127.0.0.1:55432/reviewlens_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://reviewlens:reviewlens_dev_password@127.0.0.1:55432/reviewlens_dev?schema=public"

# PostgreSQL Integration Test Database (Required for running 'npm run test:integration')
DATABASE_URL_TEST="postgresql://reviewlens:reviewlens_dev_password@127.0.0.1:55432/reviewlens_test?schema=public"
DIRECT_DATABASE_URL_TEST="postgresql://reviewlens:reviewlens_dev_password@127.0.0.1:55432/reviewlens_test?schema=public"

# Queue Configuration (pg-boss)
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5
PGBOSS_CONNECTION_TIMEOUT_MS=5000
REVIEW_QUEUE_RETRY_LIMIT=3
REVIEW_QUEUE_RETRY_DELAY_SECONDS=15
REVIEW_QUEUE_RETRY_DELAY_MAX_SECONDS=900
REVIEW_QUEUE_EXPIRE_SECONDS=300
WORKER_CONCURRENCY=1

# GitHub App Authentication (Required for Worker GitHub API operations)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Optional Live GitHub Sandbox Test (Step 7 opt-in only)
REVIEWLENS_E2E_OWNER=
REVIEWLENS_E2E_REPO=
REVIEWLENS_E2E_PULL_NUMBER=
REVIEWLENS_E2E_INSTALLATION_ID=
REVIEWLENS_E2E_ENABLE_PUBLISH=false
REVIEWLENS_E2E_CONFIRM_TARGET=

# AI Integration (Milestone M4 - Free Tier Hosted LLM)
REVIEWLENS_AI_ENABLED=false
REVIEWLENS_AI_KILL_SWITCH=false
REVIEWLENS_AI_PROFILE=development
GEMINI_API_KEY=
GROQ_API_KEY=

# Dashboard & User Authorization (Milestone M6)
# GitHub App OAuth credentials (found on your GitHub App settings page)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# 32-byte (64 hex characters) secret key for AES-256-GCM encryption of user access tokens at rest
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Web dashboard frontend URL for OAuth callback redirects and CORS
FRONTEND_URL=http://localhost:5173
